@page "/lapor/evidence"
@layout PublicLayout
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory

<section class="evidence-page">
    <div class="evidence-heading">
        <p class="evidence-badge">Bukti Pendukung</p>
        <h1>Tambah Bukti Pendukung</h1>
        <p class="evidence-lead">Masukkan Report ID dan PIN laporan terlebih dahulu sebelum menambahkan bukti baru. Data ini digunakan untuk memastikan bukti masuk ke laporan yang benar.</p>
    </div>

    @if (submitResult is null)
    {
        <form class="evidence-card evidence-form">
            <div class="evidence-grid">
                <div class="evidence-field">
                    <label for="reportId">Report ID</label>
                    <input
                        id="reportId"
                        @bind="reportId"
                        @bind:event="oninput" />
                </div>

                <div class="evidence-field">
                    <label for="pin">PIN</label>
                    <input
                        id="pin"
                        @bind="pin"
                        @bind:event="oninput" />
                </div>

                <div class="evidence-field evidence-field-full">
                    <label for="evidenceType">Evidence Type</label>
                    <select
                        id="evidenceType"
                        @bind="evidenceType">
                        <option value="0">0 - Testimoni</option>
                        <option value="1">1 - KronologiTambahan</option>
                        <option value="2">2 - CatatanPendukung</option>
                    </select>
                    <p class="evidence-helper">Pilih Testimoni untuk pernyataan saksi, KronologiTambahan untuk detail kejadian lanjutan, atau CatatanPendukung untuk catatan lain yang relevan.</p>
                </div>

                <div class="evidence-field evidence-field-full">
                    <label for="content">Content</label>
                    <textarea
                        id="content"
                        rows="4"
                        @bind="content"
                        @bind:event="oninput"></textarea>
                </div>

                <div class="evidence-field evidence-field-full">
                    <label for="description">Description</label>
                    <textarea
                        id="description"
                        rows="3"
                        @bind="description"
                        @bind:event="oninput"></textarea>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="form-alert form-alert-error">@errorMessage</div>
            }

            <button
                class="evidence-submit"
                type="button"
                disabled="@isLoading"
                @onclick="HandleSubmit">
                @(isLoading ? "Mengirim..." : "Tambah Bukti")
            </button>
        </form>
    }
    else
    {
        <div class="evidence-card evidence-success">
            <div class="form-alert form-alert-success">
                <strong>Bukti berhasil ditambahkan.</strong>
                <span>Laporan @submitResult.ReportId telah menerima bukti baru dengan jenis @submitResult.EvidenceType.</span>
            </div>

            <button class="evidence-submit" type="button" @onclick="ResetForm">Tambah bukti lain</button>
        </div>
    }
</section>

@code {
    private string reportId = string.Empty;
    private string pin = string.Empty;
    private int evidenceType;
    private string content = string.Empty;
    private string description = string.Empty;
    private bool isLoading;
    private string? errorMessage;
    private EvidenceSubmissionResult? submitResult;

    private const string EvidenceEndpointTemplate = "http://localhost:5191/api/reports/{0}/evidences";

    private async Task HandleSubmit()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(reportId)
            || string.IsNullOrWhiteSpace(pin)
            || evidenceType < 0
            || evidenceType > 2
            || string.IsNullOrWhiteSpace(content)
            || string.IsNullOrWhiteSpace(description))
        {
            errorMessage = "Semua field wajib diisi dengan benar.";
            return;
        }

        isLoading = true;

        try
        {
            var client = HttpClientFactory.CreateClient();
            var endpoint = string.Format(EvidenceEndpointTemplate, reportId);
            var request = new AddEvidenceRequest(pin, evidenceType, content, description);
            var response = await client.PostAsJsonAsync(endpoint, request);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Report ID atau PIN tidak valid. Periksa kembali kredensial laporan Anda.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<EvidenceSubmissionResult>();

            if (result is null)
            {
                errorMessage = "Response server tidak valid.";
                return;
            }

            submitResult = result;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Gagal terhubung ke server.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "Request terlalu lama. Coba lagi.";
        }
        catch
        {
            errorMessage = "Terjadi kesalahan saat menambahkan bukti.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetForm()
    {
        reportId = string.Empty;
        pin = string.Empty;
        evidenceType = 0;
        content = string.Empty;
        description = string.Empty;
        errorMessage = null;
        submitResult = null;
    }

    private sealed record AddEvidenceRequest(string Pin, int EvidenceType, string Content, string Description);

    private sealed record EvidenceSubmissionResult(
        string ReportId,
        int EvidenceType,
        string Content,
        string Description
    );
}
