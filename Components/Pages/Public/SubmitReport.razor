@page "/lapor"
@layout PublicLayout
@rendermode InteractiveServer
@using System.Text
@using System.Text.RegularExpressions
@implements IAsyncDisposable
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<section class="report-page">
    @if (submitResult is null)
    {
        <div class="report-heading">
            <p class="report-badge">Form pelaporan publik</p>
            <h1>Ajukan Laporan</h1>
            <p class="report-lead">
                Lengkapi data di bawah ini. Setelah laporan terkirim, kamu akan menerima
                Report ID dan PIN untuk melacak status laporan.
            </p>
        </div>

        <div class="report-card">
            <div class="report-grid">
                <div class="report-field">
                    <label for="reporterName">Nama pelapor</label>
                    <input
                        id="reporterName"
                        type="text"
                        placeholder="Masukkan nama lengkap"
                        value="@reporterName"
                        @oninput="HandleReporterNameInput" />
                </div>

                <div class="report-field">
                    <label for="reporterNoHP">Nomor HP pelapor</label>
                    <input
                        id="reporterNoHP"
                        type="tel"
                        placeholder="08xxxxxxxxxx"
                        value="@reporterNoHP"
                        @oninput="HandleReporterNoHPInput" />
                </div>

                <div class="report-field report-field-full">
                    <label for="title">Judul laporan</label>
                    <input
                        id="title"
                        type="text"
                        placeholder="Ringkasan singkat kejadian"
                        @bind="title"
                        @bind:event="oninput" />
                </div>

                <div class="report-field report-field-full">
                    <label for="description">Kronologi</label>
                    <textarea
                        id="description"
                        rows="5"
                        placeholder="Ceritakan kronologi kejadian secara runtut"
                        @bind="description"
                        @bind:event="oninput"></textarea>
                </div>

                <div class="report-field">
                    <label for="reportedPerson">Pihak terlapor</label>
                    <input
                        id="reportedPerson"
                        type="text"
                        placeholder="Nama pihak yang dilaporkan"
                        value="@reportedPerson"
                        @oninput="HandleReportedPersonInput" />
                </div>

                <div class="report-field">
                    <label for="location">Lokasi kejadian</label>
                    <input
                        id="location"
                        type="text"
                        placeholder="Contoh: Gedung Rektorat"
                        @bind="location"
                        @bind:event="oninput" />
                </div>

                <div class="report-field">
                    <label for="incidentDate">Tanggal &amp; waktu kejadian</label>
                    <input
                        id="incidentDate"
                        type="datetime-local"
                        @bind="incidentDate" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="report-error">
                    @errorMessage
                </div>
            }

            <button
                class="report-submit"
                type="button"
                disabled="@isLoading"
                @onclick="HandleSubmit">
                @(isLoading ? "Mengirim..." : "Kirim Laporan")
            </button>
        </div>
    }
    else
    {
        <div class="report-card report-success">
            <div class="report-success-icon">✓</div>
            <h1>Laporan Berhasil Dikirim</h1>
            <p class="report-lead">
                Simpan Report ID dan PIN di bawah ini. Keduanya dibutuhkan untuk melacak
                status laporan dan menambahkan bukti.
            </p>

            <div class="report-credentials">
                <div class="report-credential">
                    <span>Report ID</span>
                    <strong>@submitResult.ReportId</strong>
                </div>
                <div class="report-credential">
                    <span>Tracking PIN</span>
                    <strong>@submitResult.TrackingPin</strong>
                </div>
            </div>

            <p class="report-note">
                Setelah meninggalkan halaman ini, Report ID dan PIN tidak akan ditampilkan lagi.
                Unduh dan simpan terlebih dahulu, lalu pantau perkembangan laporan melalui menu
                <strong>Lacak</strong>.
            </p>

            <div class="report-success-actions">
                <button class="landing-button landing-button-primary" type="button" @onclick="SaveCredentials">
                    Simpan Report ID &amp; PIN
                </button>
                <a class="landing-button landing-button-secondary" href="/lacak">Lacak Laporan</a>
                <button class="landing-button landing-button-secondary" type="button" @onclick="ResetForm">
                    Buat Laporan Baru
                </button>
            </div>
        </div>
    }
</section>

@code {
    private string reporterName = string.Empty;
    private string reporterNoHP = string.Empty;
    private string title = string.Empty;
    private string description = string.Empty;
    private string reportedPerson = string.Empty;
    private string location = string.Empty;
    private DateTime? incidentDate;

    private string? errorMessage;
    private bool isLoading;
    private CreateReportResponse? submitResult;

    private const string ReportsEndpoint = "http://localhost:5191/api/reports";
    private const string DownloadModulePath = "./js/download.js";

    private IJSObjectReference? downloadModule;

    private async Task HandleSubmit()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(reporterName))
        {
            errorMessage = "Nama pelapor wajib diisi dengan huruf dan spasi.";
            return;
        }

        if (!IsValidReporterName(reporterName))
        {
            errorMessage = "Nama pelapor hanya boleh berisi huruf dan spasi.";
            return;
        }

        if (string.IsNullOrWhiteSpace(reporterNoHP))
        {
            errorMessage = "Nomor HP pelapor wajib diisi dengan angka.";
            return;
        }

        if (!IsDigitsOnly(reporterNoHP))
        {
            errorMessage = "Nomor HP pelapor hanya boleh berisi angka.";
            return;
        }

        if (string.IsNullOrWhiteSpace(reportedPerson))
        {
            errorMessage = "Pihak terlapor wajib diisi dengan huruf dan spasi.";
            return;
        }

        if (!IsValidPersonName(reportedPerson))
        {
            errorMessage = "Pihak terlapor hanya boleh berisi huruf dan spasi.";
            return;
        }

        if (string.IsNullOrWhiteSpace(title)
            || string.IsNullOrWhiteSpace(description)
            || string.IsNullOrWhiteSpace(location)
            || incidentDate is null)
        {
            errorMessage = "Semua field wajib diisi.";
            return;
        }

        isLoading = true;

        try
        {
            var client = HttpClientFactory.CreateClient();

            var request = new CreateReportRequest(
                reporterName,
                reporterNoHP,
                title,
                description,
                reportedPerson,
                location,
                incidentDate.Value);

            var response = await client.PostAsJsonAsync(ReportsEndpoint, request);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Laporan gagal dikirim. Periksa kembali data yang diisi.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<CreateReportResponse>();

            if (result is null)
            {
                errorMessage = "Response server tidak valid.";
                return;
            }

            submitResult = result;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Gagal terhubung ke server.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "Request terlalu lama. Coba lagi.";
        }
        catch
        {
            errorMessage = "Terjadi kesalahan saat mengirim laporan.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveCredentials()
    {
        if (submitResult is null)
        {
            return;
        }

        var fileName = $"laporan-{submitResult.ReportId}.txt";
        var content = BuildCredentialsText(submitResult);

        var module = await GetDownloadModuleAsync();
        await module.InvokeVoidAsync("downloadTextFile", fileName, content);
    }

    private static string BuildCredentialsText(CreateReportResponse result)
    {
        var builder = new StringBuilder();
        builder.AppendLine("=== Bukti Laporan ===");
        builder.AppendLine($"Report ID : {result.ReportId}");
        builder.AppendLine($"PIN       : {result.TrackingPin}");
        builder.AppendLine();
        builder.AppendLine("Simpan informasi ini baik-baik. Report ID dan PIN dibutuhkan untuk");
        builder.AppendLine("melacak progres laporan melalui menu Lacak.");
        return builder.ToString();
    }

    private async Task<IJSObjectReference> GetDownloadModuleAsync()
        => downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", DownloadModulePath);

    private void ResetForm()
    {
        reporterName = string.Empty;
        reporterNoHP = string.Empty;
        title = string.Empty;
        description = string.Empty;
        reportedPerson = string.Empty;
        location = string.Empty;
        incidentDate = null;
        errorMessage = null;
        submitResult = null;
    }

    private void HandleReporterNameInput(ChangeEventArgs args)
    {
        reporterName = SanitizeReporterName(args.Value?.ToString() ?? string.Empty);
    }

    private static string SanitizeReporterName(string value)
        => Regex.Replace(value, @"[^\p{L} ]", string.Empty);

    private static bool IsValidReporterName(string value)
        => IsValidPersonName(value);

    private void HandleReporterNoHPInput(ChangeEventArgs args)
    {
        reporterNoHP = SanitizeDigits(args.Value?.ToString() ?? string.Empty);
    }

    private void HandleReportedPersonInput(ChangeEventArgs args)
    {
        reportedPerson = SanitizePersonName(args.Value?.ToString() ?? string.Empty);
    }

    private static string SanitizePersonName(string value)
        => Regex.Replace(value, @"[^\p{L} ]", string.Empty);

    private static string SanitizeDigits(string value)
        => Regex.Replace(value, @"\D", string.Empty);

    private static bool IsValidPersonName(string value)
        => Regex.IsMatch(value, @"^[\p{L} ]+$");

    private static bool IsDigitsOnly(string value)
        => Regex.IsMatch(value, @"^\d+$");

    public async ValueTask DisposeAsync()
    {
        if (downloadModule is null)
        {
            return;
        }

        try
        {
            await downloadModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit already closed; nothing to clean up.
        }
    }

    private sealed record CreateReportRequest(
        string ReporterName,
        string ReporterNoHP,
        string Title,
        string Description,
        string ReportedPerson,
        string Location,
        DateTime IncidentDate
    );

    private sealed record CreateReportResponse(
        string ReportId,
        string TrackingPin,
        string Message
    );
}
