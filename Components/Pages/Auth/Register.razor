@page "/register"
@layout EmptyLayout

<main class="container py-5">
    <section class="mx-auto" style="max-width: 420px;">
        <h1>Register</h1>
        <p>Placeholder registrasi tanpa integrasi API.</p>

        <div class="mb-3">
            <label class="form-label" for="name">Name</label>
            <input id="name" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="noHP">No HP</label>
            <input id="noHP" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <input id="password" class="form-control" type="password" />
        </div>

        <button class="btn btn-primary" type="button">Register</button>

        @* TODO: Define registration requirements before API integration. *@
    </section>
</main>
