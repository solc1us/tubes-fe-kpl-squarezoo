@page "/login"
@layout EmptyLayout
@inject NavigationManager Navigation

<main class="login-page">
    <section class="login-card">
        <a class="login-back" href="/">← Kembali</a>

        <div class="login-heading">
            <h1>Login</h1>
            <p>Masuk sebagai Admin atau Pimpinan untuk mengelola laporan.</p>
        </div>

        <div class="login-field">
            <label for="noHP">No HP</label>
            <input id="noHP" type="text" placeholder="Masukkan nomor HP" />
        </div>

        <div class="login-field">
            <label for="password">Password</label>
            <input id="password" type="password" placeholder="Masukkan password" />
        </div>

        <button class="login-button" type="button" @onclick="GoToDashboard">Login</button>

        @* TODO: Integrate real authentication flow later. *@
    </section>
</main>

@code {
    private void GoToDashboard()
    {
        Navigation.NavigateTo("/admin/dashboard");
    }
}
