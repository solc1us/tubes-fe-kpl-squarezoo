@page "/login"
@layout EmptyLayout
@inject NavigationManager Navigation

<main class="container py-5">
    <section class="mx-auto" style="max-width: 420px;">
        <h1>Login</h1>
        <p>Placeholder login untuk Admin dan Pimpinan.</p>

        <div class="mb-3">
            <label class="form-label" for="noHP">No HP</label>
            <input id="noHP" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <input id="password" class="form-control" type="password" />
        </div>

        <button class="btn btn-primary" @onclick="GoToDashboard">Login</button>

        @* TODO: Integrate real authentication flow later. *@
    </section>
</main>

@code {
    private void GoToDashboard()
    {
        Navigation.NavigateTo("/admin/dashboard");
    }
}
