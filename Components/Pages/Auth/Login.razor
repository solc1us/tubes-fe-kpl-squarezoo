@page "/login"
@layout EmptyLayout
@rendermode InteractiveServer
@using System.Text.Json
@using System.Text.RegularExpressions
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<main class="login-page">
    @if (isCheckingSession)
    {
        <section class="login-card">
            <div class="login-heading">
                <p>Memeriksa sesi...</p>
            </div>
        </section>
    }
    else
    {
        <section class="login-card">
            <a class="login-back" href="/">&larr; Kembali</a>

            <div class="login-heading">
                <h1>Login</h1>
                <p>Masuk sebagai Admin atau Pimpinan untuk mengelola laporan.</p>
            </div>

            <div class="login-field">
                <label for="noHP">No HP</label>
                <input
                    id="noHP"
                    type="text"
                    placeholder="Masukkan nomor HP"
                    @bind="noHP"
                    @bind:event="oninput" />
            </div>

            <div class="login-field">
                <label for="password">Password</label>
                <input
                    id="password"
                    type="password"
                    placeholder="Masukkan password"
                    @bind="password"
                    @bind:event="oninput" />
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="form-alert form-alert-error login-alert">
                    @errorMessage
                </div>
            }

            <button
                class="login-button"
                type="button"
                disabled="@isLoading"
                @onclick="HandleLogin">
                @(isLoading ? "Memproses..." : "Login")
            </button>
        </section>
    }
</main>

@code {
    private const string LoginEndpoint = "http://localhost:5191/api/users/login";
    private const string UserStorageKey = "laporU_user";
    private const string LocalPhoneNumberPrefix = "08";
    private const int AdminRole = 1;
    private const int PimpinanRole = 2;
    private const int MinimumPhoneNumberLength = 10;
    private const int MaximumPhoneNumberLength = 15;

    private const string AdminDashboardRoute = "/admin/dashboard";
    private const string PimpinanDashboardRoute = "/pimpinan/dashboard";
    private const string RequiredFieldsErrorMessage = "No HP dan password wajib diisi.";
    private const string PhoneNumberDigitsErrorMessage = "Nomor HP hanya boleh berisi angka.";
    private const string PhoneNumberPrefixErrorMessage = "Nomor HP harus diawali dengan 08.";
    private const string PhoneNumberLengthErrorMessage = "Nomor HP harus terdiri dari 10 sampai 15 angka.";
    private const string InvalidCredentialErrorMessage = "No HP atau password salah.";
    private const string InvalidLoginResponseErrorMessage = "Response login tidak valid.";
    private const string UnknownRoleErrorMessage = "Role tidak dikenali.";
    private const string ServerConnectionErrorMessage = "Gagal terhubung ke server.";
    private const string RequestTimeoutErrorMessage = "Request login terlalu lama.";
    private const string UnexpectedLoginErrorMessage = "Terjadi kesalahan saat login.";

    private static readonly JsonSerializerOptions CaseInsensitiveJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private static readonly JsonSerializerOptions CamelCaseJsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    // Field yang terhubung langsung dengan form login.
    private string noHP = string.Empty;
    private string password = string.Empty;

    // Status proses dan pesan umpan balik yang ditampilkan oleh UI.
    private string? errorMessage;
    private bool isLoading;
    private bool isCheckingSession = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Cek sesi setelah render karena localStorage memerlukan JS interop.
        await CheckExistingSessionAsync();
    }

    private async Task CheckExistingSessionAsync()
    {
        var storedUser = await JS.InvokeAsync<string?>("localStorage.getItem", UserStorageKey);

        if (string.IsNullOrWhiteSpace(storedUser))
        {
            ShowLoginForm();
            return;
        }

        var existingUser = DeserializeStoredUser(storedUser);

        if (existingUser is null)
        {
            await ClearStoredUserAndShowLogin();
            return;
        }

        if (CanRedirectByRole(existingUser.Role))
        {
            RedirectByRole(existingUser.Role, replaceHistory: true);
            return;
        }

        await ClearStoredUserAndShowLogin();
    }

    private async Task HandleLogin()
    {
        ClearLoginFeedback();

        // Validasi input sebelum mengirim request login ke backend.
        if (!ValidateLoginForm())
        {
            return;
        }

        isLoading = true;

        try
        {
            var request = BuildLoginRequest();
            var response = await SendLoginRequestAsync(request);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = InvalidCredentialErrorMessage;
                return;
            }

            var loginResult = await ReadLoginResponseAsync(response);

            if (loginResult is null)
            {
                errorMessage = InvalidLoginResponseErrorMessage;
                return;
            }

            if (CanRedirectByRole(loginResult.Role))
            {
                await HandleSuccessfulLoginAsync(loginResult);
                return;
            }

            errorMessage = UnknownRoleErrorMessage;
        }
        catch (HttpRequestException)
        {
            errorMessage = ServerConnectionErrorMessage;
        }
        catch (TaskCanceledException)
        {
            errorMessage = RequestTimeoutErrorMessage;
        }
        catch
        {
            errorMessage = UnexpectedLoginErrorMessage;
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool ValidateLoginForm()
    {
        errorMessage = GetValidationError();
        return string.IsNullOrWhiteSpace(errorMessage);
    }

    private string? GetValidationError()
    {
        var normalizedPhoneNumber = noHP.Trim();

        if (string.IsNullOrWhiteSpace(normalizedPhoneNumber) || string.IsNullOrWhiteSpace(password))
        {
            return RequiredFieldsErrorMessage;
        }

        if (!IsOnlyDigits(normalizedPhoneNumber))
        {
            return PhoneNumberDigitsErrorMessage;
        }

        if (!StartsWithLocalPhonePrefix(normalizedPhoneNumber))
        {
            return PhoneNumberPrefixErrorMessage;
        }

        if (!HasValidPhoneLength(normalizedPhoneNumber))
        {
            return PhoneNumberLengthErrorMessage;
        }

        return null;
    }

    private LoginRequest BuildLoginRequest()
    {
        // Trim No HP, tetapi pertahankan password sesuai input pengguna.
        return new LoginRequest(noHP.Trim(), password);
    }

    private async Task<HttpResponseMessage> SendLoginRequestAsync(LoginRequest request)
    {
        var client = HttpClientFactory.CreateClient();
        return await client.PostAsJsonAsync(LoginEndpoint, request);
    }

    private static async Task<LoginResponse?> ReadLoginResponseAsync(HttpResponseMessage response)
    {
        return await response.Content.ReadFromJsonAsync<LoginResponse>();
    }

    private async Task HandleSuccessfulLoginAsync(LoginResponse loginResult)
    {
        // Simpan response login berhasil untuk proteksi route sederhana pada MVP.
        await SaveUserSessionAsync(loginResult);
        RedirectByRole(loginResult.Role);
    }

    private async Task SaveUserSessionAsync(LoginResponse loginResult)
    {
        var storedUser = JsonSerializer.Serialize(loginResult, CamelCaseJsonOptions);

        await JS.InvokeVoidAsync("localStorage.setItem", UserStorageKey, storedUser);
    }

    private void RedirectByRole(int role, bool replaceHistory = false)
    {
        var route = role == AdminRole ? AdminDashboardRoute : PimpinanDashboardRoute;
        Navigation.NavigateTo(route, replace: replaceHistory);
    }

    private static bool CanRedirectByRole(int role)
    {
        return role is AdminRole or PimpinanRole;
    }

    private static StoredLoginResponse? DeserializeStoredUser(string storedUser)
    {
        try
        {
            return JsonSerializer.Deserialize<StoredLoginResponse>(storedUser, CaseInsensitiveJsonOptions);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private async Task ClearStoredUserAndShowLogin()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", UserStorageKey);
        ShowLoginForm();
    }

    private void ClearLoginFeedback()
    {
        errorMessage = null;
    }

    private void ShowLoginForm()
    {
        isCheckingSession = false;
        StateHasChanged();
    }

    private static bool IsOnlyDigits(string value)
    {
        return Regex.IsMatch(value, @"^\d+$");
    }

    private static bool HasValidPhoneLength(string value)
    {
        return value.Length >= MinimumPhoneNumberLength && value.Length <= MaximumPhoneNumberLength;
    }

    private static bool StartsWithLocalPhonePrefix(string value)
    {
        return value.StartsWith(LocalPhoneNumberPrefix, StringComparison.Ordinal);
    }

    private sealed record LoginRequest(string NoHP, string Password);

    private sealed record StoredLoginResponse(int Role);

    private sealed record LoginResponse(
        Guid UserId,
        string Name,
        string NoHP,
        int Role,
        List<string> Permissions
    );
}
