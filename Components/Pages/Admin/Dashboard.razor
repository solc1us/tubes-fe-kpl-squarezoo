@page "/admin/dashboard"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory

<RequireLogin RequiredRole="1">
<section class="admin-dashboard-page">
    <div class="admin-dashboard-heading">
        <h1>Dashboard Admin</h1>
        <p>Menampilkan jumlah laporan berdasarkan status saat ini.</p>
    </div>

    @if (_isLoading)
    {
        <div class="admin-dashboard-card">
            <p>Memuat data dashboard...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="admin-dashboard-error">
            @_errorMessage
        </div>
    }
    else if (_summary != null)
    {
        <div class="admin-summary-grid">
            @foreach (var card in GetSummaryCards())
            {
                <div class="admin-summary-card @card.CssClass">
                    <span>@card.Label</span>
                    <strong>@card.Value</strong>
                </div>
            }
        </div>
    }
</section>
</RequireLogin>

@code {
    // API endpoint dashboard dipusatkan agar mudah diganti ketika konfigurasi backend sudah tersedia.
    private const string SummaryEndpoint = "http://localhost:5191/api/reports/summary";
    private const string LoadFailedMessage = "Gagal mengambil data dashboard. Silakan coba lagi.";

    private ReportSummary? _summary;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient();
            _summary = await httpClient.GetFromJsonAsync<ReportSummary>(SummaryEndpoint);
        }
        catch (Exception)
        {
            _errorMessage = LoadFailedMessage;
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Data card dibuat dari satu sumber agar markup dashboard tidak berulang.
    private SummaryCard[] GetSummaryCards()
    {
        if (_summary == null)
        {
            return Array.Empty<SummaryCard>();
        }

        return new[]
        {
            new SummaryCard("Total Laporan", _summary.Total, "admin-summary-total"),
            new SummaryCard("Diterima", _summary.Diterima, "admin-summary-diterima"),
            new SummaryCard("Diproses", _summary.Diproses, "admin-summary-diproses"),
            new SummaryCard("Selesai", _summary.Selesai, "admin-summary-selesai"),
            new SummaryCard("Ditolak", _summary.Ditolak, "admin-summary-ditolak")
        };
    }

    public sealed class ReportSummary
    {
        public int Total { get; set; }
        public int Diterima { get; set; }
        public int Diproses { get; set; }
        public int Selesai { get; set; }
        public int Ditolak { get; set; }
    }

    private sealed record SummaryCard(string Label, int Value, string CssClass);
}
