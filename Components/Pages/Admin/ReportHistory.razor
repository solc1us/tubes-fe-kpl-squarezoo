@page "/admin/laporan/history"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

@if (isLoading)
{
    <p>Memuat data laporan...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p>@errorMessage</p>
}
else if (reports.Count == 0)
{
    <p>Belum ada history laporan.</p>
}
else
{
    <table class="admin-reports-table">
        <thead>
            <tr>
                <th>No</th>
                <th>Judul</th>
                <th>Pelapor</th>
                <th>Terlapor</th>
                <th>Lokasi</th>
                <th>Tanggal</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @for (int i = 0; i < reports.Count; i++)
            {
                var report = reports[i];

                <tr>
                    <td>@(i + 1)</td>
                    <td>@report.Title</td>
                    <td>@report.ReporterName</td>
                    <td>@report.ReportedPerson</td>
                    <td>@report.Location</td>
                    <td>@FormatDate(report.IncidentDate)</td>
                    <td>@GetStatusText(report.Status)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

private List<ReportItem> reports = new();

private bool isLoading = true;

private string? errorMessage;

protected override async Task OnInitializedAsync()
{
    await LoadReports();
}

private async Task LoadReports()
{
    try
    {
        var httpClient = HttpClientFactory.CreateClient();

        var selesai =
            await httpClient.GetFromJsonAsync<List<ReportItem>>(
                "http://localhost:5191/api/reports?status=2"
            ) ?? new List<ReportItem>();

        var ditolak =
            await httpClient.GetFromJsonAsync<List<ReportItem>>(
                "http://localhost:5191/api/reports?status=3"
            ) ?? new List<ReportItem>();

        reports = selesai.Concat(ditolak).ToList();
    }
    catch (Exception ex)
    {
        errorMessage = ex.Message;
    }
    finally
    {
        isLoading = false;
    }
}

private string GetStatusText(int status)
{
    return status switch
    {
        0 => "Diterima",
        1 => "Diproses",
        2 => "Selesai",
        3 => "Ditolak",
        _ => "Tidak diketahui"
    };
}

private string FormatDate(DateTime? date)
{
    return date.HasValue
        ? date.Value.ToString("dd MMM yyyy")
        : "-";
}

public class ReportItem
{
    public Guid ReportId { get; set; }

    public string? Title { get; set; }

    public string? ReporterName { get; set; }

    public string? ReporterNoHP { get; set; }

    public string? ReportedPerson { get; set; }

    public string? Location { get; set; }

    public DateTime? IncidentDate { get; set; }

    public int Status { get; set; }
}

}