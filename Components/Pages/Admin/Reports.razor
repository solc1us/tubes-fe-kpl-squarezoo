@page "/admin/laporan"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@inject IHttpClientFactory HttpClientFactory

<RequireLogin RequiredRole="1">
    <section class="admin-reports-page">
        <div class="admin-reports-heading">
            <h1>Laporan Masuk</h1>
            <p>Menampilkan laporan yang masih perlu ditinjau oleh admin.</p>
        </div>

        <div class="admin-reports-toolbar">
            <div class="admin-reports-search">
                <label for="searchTitle">Cari berdasarkan judul</label>

                <div class="admin-reports-search-row">
                    <input id="searchTitle"
                           type="text"
                           placeholder="Masukkan judul laporan..."
                           @bind="searchTitle"
                           @bind:event="oninput"
                           @onkeydown="HandleSearchKeyDown" />

                    <button type="button" @onclick="SearchReports">
                        Cari
                    </button>

                    <button type="button" class="secondary" @onclick="ResetSearch">
                        Reset
                    </button>
                </div>
            </div>

            <div class="admin-reports-page-size">
                <label for="pageSize">Data per halaman</label>

                <select id="pageSize" @onchange="ChangePageSize">
                    <option value="5" selected="@(pageSize == 5)">5</option>
                    <option value="10" selected="@(pageSize == 10)">10</option>
                    <option value="20" selected="@(pageSize == 20)">20</option>
                </select>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="admin-reports-card">
                <p>Memuat data laporan...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="admin-reports-error">
                @errorMessage
            </div>
        }
        else if (pagedReports == null || pagedReports.Count == 0)
        {
            <div class="admin-reports-card">
                <p>@GetEmptyMessage()</p>
            </div>
        }
        else
        {
            <div class="admin-reports-table-card">
                <table class="admin-reports-table">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Judul</th>
                            <th>Pelapor</th>
                            <th>Terlapor</th>
                            <th>Lokasi</th>
                            <th>Tanggal Kejadian</th>
                            <th>Status</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < pagedReports.Count; i++)
                        {
                            var report = pagedReports[i];

                            <tr>
                                <td>@(((currentPage - 1) * pageSize) + i + 1)</td>
                                <td>@(report.Title ?? "-")</td>
                                <td>
                                    <div class="reporter-name">@(report.ReporterName ?? "-")</div>
                                    <div class="reporter-phone">@(report.ReporterNoHP ?? "-")</div>
                                </td>
                                <td>@(report.ReportedPerson ?? "-")</td>
                                <td>@(report.Location ?? "-")</td>
                                <td>@FormatDate(report.IncidentDate)</td>
                                <td>
                                    <span class="@GetStatusBadgeClass(report.Status)">
                                        @GetStatusText(report.Status)
                                    </span>
                                </td>
                                <td>
                                    <a class="admin-detail-button" href="/admin/laporan/detail/@report.ReportId">
                                        Detail
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="admin-reports-pagination">
                <div>
                    Displaying @pagedReports.Count of @allReports.Count reports
                </div>

                <div class="admin-reports-pagination-actions">
                    <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1)">
                        Previous
                    </button>

                    <span>Page @currentPage of @totalPages</span>

                    <button type="button" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                        Next
                    </button>
                </div>
            </div>
        }
    </section>
</RequireLogin>

@code {
    private List<ReportItem> allReports = new();
    private List<ReportItem> pagedReports = new();

    private bool isLoading = true;
    private string? errorMessage;
    private string? searchTitle;

    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var diterimaReports = await GetAllReportsByStatus(0);
            var diprosesReports = await GetAllReportsByStatus(1);

            allReports = diterimaReports
                .Concat(diprosesReports)
                .OrderByDescending(report => report.IncidentDate)
                .ToList();

            SetPagedReports();
        }
        catch (Exception)
        {
            errorMessage = "Gagal mengambil data laporan. Silakan coba lagi.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<List<ReportItem>> GetAllReportsByStatus(int status)
    {
        var result = new List<ReportItem>();
        var page = 1;
        var backendPageSize = 50;
        var hasNextPage = true;

        while (hasNextPage)
        {
            var response = await GetReportsByStatus(status, page, backendPageSize);

            if (response == null)
            {
                break;
            }

            result.AddRange(response.Items);

            hasNextPage = response.HasNextPage;
            page++;
        }

        return result;
    }

    private async Task<PaginatedReportResponse?> GetReportsByStatus(int status, int page, int backendPageSize)
    {
        var httpClient = HttpClientFactory.CreateClient();

        var titleQuery = string.IsNullOrWhiteSpace(searchTitle)
            ? ""
            : $"&title={Uri.EscapeDataString(searchTitle)}";

        var url = $"http://localhost:5191/api/reports?status={status}{titleQuery}&page={page}&pageSize={backendPageSize}";

        return await httpClient.GetFromJsonAsync<PaginatedReportResponse>(url);
    }

    private void SetPagedReports()
    {
        totalPages = allReports.Count == 0
            ? 1
            : (int)Math.Ceiling(allReports.Count / (double)pageSize);

        if (currentPage > totalPages)
        {
            currentPage = totalPages;
        }

        pagedReports = allReports
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private async Task SearchReports()
    {
        currentPage = 1;
        await LoadReports();
    }

    private async Task ResetSearch()
    {
        searchTitle = string.Empty;
        currentPage = 1;
        await LoadReports();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchReports();
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            SetPagedReports();
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            SetPagedReports();
        }
    }

    private void ChangePageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var selectedPageSize))
        {
            pageSize = selectedPageSize;
            currentPage = 1;
            SetPagedReports();
        }
    }

    private int GetStartItemNumber()
    {
        if (allReports.Count == 0)
        {
            return 0;
        }

        return ((currentPage - 1) * pageSize) + 1;
    }

    private int GetEndItemNumber()
    {
        var endItem = currentPage * pageSize;
        return endItem > allReports.Count ? allReports.Count : endItem;
    }

    private string GetEmptyMessage()
    {
        return string.IsNullOrWhiteSpace(searchTitle)
            ? "Belum ada laporan dengan status diterima atau diproses."
            : "Tidak ada laporan yang sesuai dengan judul pencarian.";
    }

    private string GetStatusText(int status)
    {
        return status switch
        {
            0 => "Diterima",
            1 => "Diproses",
            _ => "Tidak diketahui"
        };
    }

    private string GetStatusBadgeClass(int status)
    {
        return status switch
        {
            0 => "status-badge status-diterima",
            1 => "status-badge status-diproses",
            _ => "status-badge"
        };
    }

    private string FormatDate(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString("dd MMM yyyy")
            : "-";
    }

    public class PaginatedReportResponse
    {
        public List<ReportItem> Items { get; set; } = new();
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int TotalItems { get; set; }
        public int TotalPages { get; set; }
        public bool HasPreviousPage { get; set; }
        public bool HasNextPage { get; set; }
    }

    public class ReportItem
    {
        public Guid ReportId { get; set; }
        public string? ReporterName { get; set; }
        public string? ReporterNoHP { get; set; }
        public string? Title { get; set; }
        public string? Description { get; set; }
        public string? ReportedPerson { get; set; }
        public string? Location { get; set; }
        public DateTime? IncidentDate { get; set; }
        public int Status { get; set; }
    }
}