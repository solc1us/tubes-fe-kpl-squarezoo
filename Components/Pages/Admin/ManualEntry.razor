@page "/admin/manual-entry"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@inject IHttpClientFactory HttpClientFactory

<RequireLogin RequiredRole="1">
<section class="manual-entry-page">
    <div class="manual-entry-heading">
        <h1>Manual Entry</h1>
        <p>Catat laporan yang diterima melalui kanal non-digital.</p>
    </div>

    <div class="manual-entry-card">
        <div class="manual-entry-form">
            <div class="form-grid">
                <div class="manual-entry-field">
                    <label for="reporterName">Nama Pelapor</label>
                    <input
                        id="reporterName"
                        type="text"
                        placeholder="Masukkan nama pelapor"
                        @bind="reporterName"
                        @bind:event="oninput" />
                </div>

                <div class="manual-entry-field">
                    <label for="reporterNoHP">No HP Pelapor</label>
                    <input
                        id="reporterNoHP"
                        type="text"
                        placeholder="Masukkan nomor HP"
                        @bind="reporterNoHP"
                        @bind:event="oninput" />
                </div>

                <div class="manual-entry-field form-field-full">
                    <label for="title">Judul Laporan</label>
                    <input
                        id="title"
                        type="text"
                        placeholder="Masukkan judul laporan"
                        @bind="title"
                        @bind:event="oninput" />
                </div>

                <div class="manual-entry-field form-field-full">
                    <label for="description">Kronologi / Deskripsi</label>
                    <textarea
                        id="description"
                        rows="5"
                        placeholder="Tuliskan kronologi laporan"
                        @bind="description"
                        @bind:event="oninput"></textarea>
                </div>

                <div class="manual-entry-field">
                    <label for="reportedPerson">Pihak Terlapor</label>
                    <input
                        id="reportedPerson"
                        type="text"
                        placeholder="Masukkan pihak terlapor"
                        @bind="reportedPerson"
                        @bind:event="oninput" />
                </div>

                <div class="manual-entry-field">
                    <label for="location">Lokasi Kejadian</label>
                    <input
                        id="location"
                        type="text"
                        placeholder="Masukkan lokasi kejadian"
                        @bind="location"
                        @bind:event="oninput" />
                </div>

                <div class="manual-entry-field">
                    <label for="incidentDate">Tanggal Kejadian</label>
                    <input
                        id="incidentDate"
                        type="date"
                        @bind="incidentDate" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="form-message form-message-error">
                    @errorMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="form-message form-message-success">
                    <strong>@successMessage</strong>

                    @if (!string.IsNullOrWhiteSpace(createdReportId) || !string.IsNullOrWhiteSpace(createdTrackingPin))
                    {
                        <div class="manual-entry-result">
                            @if (!string.IsNullOrWhiteSpace(createdReportId))
                            {
                                <div>
                                    <span>Report ID</span>
                                    <strong>@createdReportId</strong>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(createdTrackingPin))
                            {
                                <div>
                                    <span>Tracking PIN</span>
                                    <strong>@createdTrackingPin</strong>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <button
                class="manual-entry-submit"
                type="button"
                disabled="@isSubmitting"
                @onclick="HandleSubmit">
                @(isSubmitting ? "Menyimpan..." : "Simpan Laporan")
            </button>
        </div>
    </div>
</section>
</RequireLogin>

@code {
    // Simpan endpoint dan pesan yang digunakan ulang agar perilaku tetap konsisten.
    private const string CreateReportEndpoint = "http://localhost:5191/api/reports";
    private const string LocalPhoneNumberPrefix = "08";
    private const int MinimumPhoneNumberLength = 10;
    private const int MaximumPhoneNumberLength = 15;

    private const string RequiredFieldsErrorMessage = "Semua field wajib diisi.";
    private const string ReporterNameFormatErrorMessage = "Nama pelapor hanya boleh berisi huruf dan spasi.";
    private const string PhoneNumberDigitsErrorMessage = "Nomor HP hanya boleh berisi angka.";
    private const string PhoneNumberPrefixErrorMessage = "Nomor HP harus diawali dengan 08.";
    private const string PhoneNumberLengthErrorMessage = "Nomor HP harus terdiri dari 10 sampai 15 angka.";
    private const string TitleFormatErrorMessage = "Judul laporan hanya boleh berisi huruf dan spasi.";
    private const string ReportedPersonFormatErrorMessage = "Pihak terlapor hanya boleh berisi huruf dan spasi.";
    private const string LocationFormatErrorMessage = "Lokasi kejadian harus memuat keterangan tempat yang valid.";
    private const string SaveReportErrorMessage = "Gagal menyimpan laporan manual.";
    private const string ServerConnectionErrorMessage = "Gagal terhubung ke server laporan.";
    private const string RequestTimeoutErrorMessage = "Request simpan laporan terlalu lama.";
    private const string UnexpectedSaveErrorMessage = "Terjadi kesalahan saat menyimpan laporan.";
    private const string DefaultSuccessMessage = "Laporan manual berhasil disimpan.";

    // Field yang terhubung langsung dengan form manual entry.
    private string reporterName = string.Empty;
    private string reporterNoHP = string.Empty;
    private string title = string.Empty;
    private string description = string.Empty;
    private string reportedPerson = string.Empty;
    private string location = string.Empty;
    private DateTime? incidentDate;

    // Status pengiriman dan umpan balik yang ditampilkan oleh UI.
    private bool isSubmitting;
    private string? errorMessage;
    private string? successMessage;
    private string? createdReportId;
    private string? createdTrackingPin;

    // Mengatur validasi, pengiriman API, dan umpan balik untuk satu aksi submit.
    private async Task HandleSubmit()
    {
        ResetSubmissionFeedback();

        // Hentikan pengiriman saat aturan validasi pertama gagal.
        if (!ValidateForm())
        {
            return;
        }

        isSubmitting = true;

        try
        {
            // Buat payload request yang sudah dinormalisasi setelah validasi berhasil.
            var request = BuildCreateReportRequest();
            var response = await SubmitCreateReportRequest(request);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = SaveReportErrorMessage;
                return;
            }

            var createdReport = await ReadCreateReportResponse(response);
            HandleSuccessfulSubmission(createdReport);
        }
        catch (HttpRequestException)
        {
            errorMessage = ServerConnectionErrorMessage;
        }
        catch (TaskCanceledException)
        {
            errorMessage = RequestTimeoutErrorMessage;
        }
        catch
        {
            errorMessage = UnexpectedSaveErrorMessage;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool ValidateForm()
    {
        // Simpan satu pesan validasi agar UI tetap ringkas.
        errorMessage = GetValidationError();
        return string.IsNullOrWhiteSpace(errorMessage);
    }

    private string? GetValidationError()
    {
        // Gunakan nilai yang sudah dinormalisasi untuk validasi tanpa mengubah isi form aktif.
        var normalizedReporterName = reporterName.Trim();
        var normalizedPhoneNumber = reporterNoHP.Trim();
        var normalizedTitle = title.Trim();
        var normalizedReportedPerson = reportedPerson.Trim();
        var normalizedLocation = location.Trim();

        if (HasEmptyRequiredFields())
        {
            return RequiredFieldsErrorMessage;
        }

        // Validasi dari atas ke bawah dan kembalikan hanya field pertama yang tidak valid.
        if (!IsOnlyLettersAndSpaces(normalizedReporterName))
        {
            return ReporterNameFormatErrorMessage;
        }

        if (!IsOnlyDigits(normalizedPhoneNumber))
        {
            return PhoneNumberDigitsErrorMessage;
        }

        if (!StartsWithLocalPhonePrefix(normalizedPhoneNumber))
        {
            return PhoneNumberPrefixErrorMessage;
        }

        if (!HasValidPhoneNumberLength(normalizedPhoneNumber))
        {
            return PhoneNumberLengthErrorMessage;
        }

        if (!IsOnlyLettersAndSpaces(normalizedTitle))
        {
            return TitleFormatErrorMessage;
        }

        if (!IsOnlyLettersAndSpaces(normalizedReportedPerson))
        {
            return ReportedPersonFormatErrorMessage;
        }

        if (!IsValidLocation(normalizedLocation))
        {
            return LocationFormatErrorMessage;
        }

        return null;
    }

    private CreateReportRequest BuildCreateReportRequest()
    {
        // Trim string di sini agar backend menerima nilai payload yang sudah dinormalisasi.
        return new CreateReportRequest(
            reporterName.Trim(),
            reporterNoHP.Trim(),
            title.Trim(),
            description.Trim(),
            reportedPerson.Trim(),
            location.Trim(),
            incidentDate!.Value
        );
    }

    private async Task<HttpResponseMessage> SubmitCreateReportRequest(CreateReportRequest request)
    {
        // Pisahkan pengiriman API dari validasi form dan penanganan response.
        var client = HttpClientFactory.CreateClient();
        return await client.PostAsJsonAsync(CreateReportEndpoint, request);
    }

    private static async Task<CreateReportResponse?> ReadCreateReportResponse(HttpResponseMessage response)
    {
        // Body response bersifat opsional; JSON yang tidak terbaca tidak boleh menutupi penyimpanan yang berhasil.
        try
        {
            return await response.Content.ReadFromJsonAsync<CreateReportResponse>();
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
        catch (NotSupportedException)
        {
            return null;
        }
    }

    private void HandleSuccessfulSubmission(CreateReportResponse? response)
    {
        // Terapkan umpan balik sukses sebelum mengosongkan field form.
        successMessage = response?.Message ?? DefaultSuccessMessage;
        createdReportId = response?.ReportId;
        createdTrackingPin = response?.TrackingPin;

        ResetForm();
    }

    private bool HasEmptyRequiredFields()
    {
        // String yang hanya berisi spasi dan tanggal yang belum dipilih dianggap sebagai input kosong.
        return string.IsNullOrWhiteSpace(reporterName)
            || string.IsNullOrWhiteSpace(reporterNoHP)
            || string.IsNullOrWhiteSpace(title)
            || string.IsNullOrWhiteSpace(description)
            || string.IsNullOrWhiteSpace(reportedPerson)
            || string.IsNullOrWhiteSpace(location)
            || !incidentDate.HasValue;
    }

    private static bool IsOnlyDigits(string value)
    {
        // Nomor HP harus berupa angka sebelum pemeriksaan awalan dan panjang dijalankan.
        return Regex.IsMatch(value, @"^\d+$");
    }

    private static bool IsOnlyLettersAndSpaces(string value)
    {
        // Huruf Unicode membuat nama Indonesia dan nama valid lain tetap terbaca dan diterima.
        return Regex.IsMatch(value, @"^[\p{L}\s]+$");
    }

    private static bool HasValidPhoneNumberLength(string value)
    {
        return value.Length >= MinimumPhoneNumberLength && value.Length <= MaximumPhoneNumberLength;
    }

    private static bool StartsWithLocalPhonePrefix(string value)
    {
        return value.StartsWith(LocalPhoneNumberPrefix, StringComparison.Ordinal);
    }

    private static bool IsValidLocation(string value)
    {
        // Lokasi boleh berisi angka dan simbol, tetapi harus menjelaskan tempat.
        return value.Any(char.IsLetter);
    }

    private void ResetSubmissionFeedback()
    {
        // Bersihkan pesan sebelumnya sebelum memulai percobaan submit baru.
        errorMessage = null;
        successMessage = null;
        createdReportId = null;
        createdTrackingPin = null;
    }

    private void ResetForm()
    {
        // Kosongkan input form hanya setelah laporan manual berhasil dikirim.
        reporterName = string.Empty;
        reporterNoHP = string.Empty;
        title = string.Empty;
        description = string.Empty;
        reportedPerson = string.Empty;
        location = string.Empty;
        incidentDate = null;
    }

    private sealed record CreateReportRequest(
        string ReporterName,
        string ReporterNoHP,
        string Title,
        string Description,
        string ReportedPerson,
        string Location,
        DateTime IncidentDate
    );

    private sealed record CreateReportResponse(
        string? ReportId,
        string? TrackingPin,
        string? Message
    );
}
