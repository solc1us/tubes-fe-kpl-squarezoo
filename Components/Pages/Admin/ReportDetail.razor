@page "/admin/laporan/detail/{id}"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<h1>Detail Laporan</h1>

@if (isLoading)
{
    <p>Memuat detail laporan...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else if (report is not null)
{
    <div class="card p-4">

        <h3>@report.Title</h3>

        <hr />

        <p><strong>Pelapor:</strong> @report.ReporterName</p>
        <p><strong>No HP:</strong> @report.ReporterNoHP</p>
        <p><strong>Terlapor:</strong> @report.ReportedPerson</p>
        <p><strong>Lokasi:</strong> @report.Location</p>
        <p><strong>Tanggal Kejadian:</strong> @FormatDate(report.IncidentDate)</p>
        <p><strong>Status:</strong> @GetStatusText(report.Status)</p>

        <hr />

        <h4>Kronologi</h4>

        <p>
            @(string.IsNullOrWhiteSpace(report.Description)
                ? "-"
                : report.Description)
        </p>

        <hr />

        <h4>Bukti / Evidence</h4>

        @if (report.Evidences == null || report.Evidences.Count == 0)
        {
            <p>Tidak ada evidence.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Tipe</th>
                        <th>Konten</th>
                        <th>Deskripsi</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var evidence in report.Evidences)
                    {
                        <tr>
                            <td>@GetEvidenceType(evidence.Type)</td>
                            <td>@evidence.Content</td>
                            <td>@evidence.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {

    [Parameter]
    public string? id { get; set; }

    private ReportDetailResponse? report;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadReport();
    }

    private async Task LoadReport()
    {
        if (string.IsNullOrWhiteSpace(id))
        {
            errorMessage = "Report ID tidak ditemukan.";
            isLoading = false;
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = null;

            var httpClient = HttpClientFactory.CreateClient();

            report = await httpClient.GetFromJsonAsync<ReportDetailResponse>(
                $"http://localhost:5191/api/reports/{id}"
            );
        }
        catch (Exception ex)
        {
            errorMessage = $"Gagal mengambil detail laporan: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusText(int status)
    {
        return status switch
        {
            0 => "Diterima",
            1 => "Diproses",
            2 => "Selesai",
            3 => "Ditolak",
            _ => "Tidak diketahui"
        };
    }

    private string GetEvidenceType(int type)
    {
        return type switch
        {
            0 => "Testimoni",
            1 => "Keterangan Korban",
            _ => "Lainnya"
        };
    }

    private string FormatDate(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString("dd MMM yyyy")
            : "-";
    }

    public class ReportDetailResponse
    {
        public Guid ReportId { get; set; }
        public string? ReporterName { get; set; }
        public string? ReporterNoHP { get; set; }
        public string? Title { get; set; }
        public string? Description { get; set; }
        public string? ReportedPerson { get; set; }
        public string? Location { get; set; }
        public DateTime? IncidentDate { get; set; }
        public int Status { get; set; }

        public List<EvidenceItem> Evidences { get; set; } = new();
    }

    public class EvidenceItem
    {
        public Guid EvidenceId { get; set; }
        public int Type { get; set; }
        public string? Content { get; set; }
        public string? Description { get; set; }
    }
}